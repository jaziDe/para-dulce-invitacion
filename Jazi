<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>💖 Para Dulce 💖</title>

<style>
body{
    margin:0;
    font-family:Arial, sans-serif;
    background:linear-gradient(135deg,#ffb6c1,#ff69b4);
    color:white;
    text-align:center;
    overflow-x:hidden;
}

.contenedor{
    max-width:700px;
    margin:50px auto;
    background:rgba(255,255,255,0.15);
    padding:30px;
    border-radius:20px;
    backdrop-filter:blur(10px);
}

h1{
    font-size:2.2rem;
}

button{
    background:#ff1493;
    color:white;
    border:none;
    padding:12px 20px;
    margin:10px;
    border-radius:15px;
    cursor:pointer;
    font-size:16px;
}

button:hover{
    background:#c71585;
}

.oculto{
    display:none;
}

input, select{
    padding:10px;
    border-radius:10px;
    border:none;
    margin:10px;
    width:80%;
}

.corazon{
    position:fixed;
    color:red;
    animation:subir 5s linear infinite;
    font-size:25px;
}

@keyframes subir{
    from{
        transform:translateY(100vh);
        opacity:1;
    }
    to{
        transform:translateY(-100px);
        opacity:0;
    }
}
</style>
</head>

<body>

<div class="contenedor">

<div id="pantalla1">

<h1>💖 Hola mi amor 💖</h1>

<h2>¿Te gustaría salir conmigo?</h2>

<button onclick="respuesta('Sí, claro mi amor')">
💘 Sí, claro mi amor
</button>

<button onclick="respuesta('opción(a)')">
💕 opción(a)
</button>

</div>

<div id="pantalla2" class="oculto">

<h2>💕 ¿A dónde te gustaría ir? 💕</h2>

<select id="lugar">
<option value="Al cine">🎬 Al cine</option>
<option value="A comer">🍔 A comer</option>
<option value="Otro lugar">🌹 Otro lugar</option>
</select>

<input type="text" id="otroLugar"
placeholder="Si elegiste otro lugar escríbelo aquí">

<br>

<button onclick="siguienteLugar()">
Continuar ❤️
</button>

</div>

<div id="pantalla3" class="oculto">

<h2>💖 Está bien mi amorrrrrrr 💖</h2>

<p>Ahora elige la fecha</p>

<input type="date" id="fecha" min="2026-11-15">

<br>

<button onclick="finalizar()">
Enviar respuesta 💌
</button>

</div>

<div id="pantalla4" class="oculto">

<h1>❤️ Gracias mi amor ❤️</h1>

<p id="resultado"></p>

</div>

</div>

<script>

let datos={
respuesta:"",
lugar:"",
fecha:""
};

function respuesta(opcion){
datos.respuesta=opcion;

document.getElementById("pantalla1").classList.add("oculto");
document.getElementById("pantalla2").classList.remove("oculto");
}

function siguienteLugar(){

let lugar=document.getElementById("lugar").value;

if(lugar==="Otro lugar"){
let otro=document.getElementById("otroLugar").value;

if(otro!=""){
lugar=otro;
}
}

datos.lugar=lugar;

document.getElementById("pantalla2").classList.add("oculto");
document.getElementById("pantalla3").classList.remove("oculto");
}

function finalizar(){

let fecha=document.getElementById("fecha").value;

if(fecha==""){
alert("Selecciona una fecha ❤️");
return;
}

datos.fecha=fecha;

document.getElementById("pantalla3").classList.add("oculto");
document.getElementById("pantalla4").classList.remove("oculto");

document.getElementById("resultado").innerHTML=
`
✅ Respuesta: ${datos.respuesta}<br><br>
✅ Lugar: ${datos.lugar}<br><br>
✅ Fecha: ${datos.fecha}
`;

console.log("DATOS RECIBIDOS");
console.log(datos);
}

function crearCorazon(){

const corazon=document.createElement("div");

corazon.classList.add("corazon");
corazon.innerHTML="❤️";

corazon.style.left=Math.random()*100+"vw";

document.body.appendChild(corazon);

setTimeout(()=>{
corazon.remove();
},5000);

}

setInterval(crearCorazon,500);

</script>

</body>
</html>
